<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>SKIT.FlurlHttpClient.Baidu.SmartApp</PackageId>
        <PackageVersion>4.0.0-dev</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Baidu</PackageProjectUrl>
		<PackageTags>Flurl.Http; Baidu; 百度; 百度小程序; 百度智能小程序; SmartApp; SmartProgram</PackageTags>
		<Authors>Fu Diwei; code-jar</Authors>
		<Description>基于 Flurl.Http 的百度智能小程序开放平台 API 客户端 SDK。</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.xml" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.1" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
	</ItemGroup>

</Project>
